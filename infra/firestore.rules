rules_version = '2';
// Dashboard clients (Firebase Auth, anonymous allowed) get read-only realtime access.
// All writes go through the Prompt2Prod API / agent runner (Admin SDK bypasses rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /projects/{projectId} {
      allow read: if request.auth != null;
    }
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      match /events/{eventId} {
        allow read: if request.auth != null;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
